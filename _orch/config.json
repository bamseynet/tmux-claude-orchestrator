{
  "target_repo": "",
  "intervals": {
    "normal_seconds": 20,
    "idle_seconds": 60
  },
  "heartbeat": {
    "max_draft_requeue_ticks": 10,
    "max_draft_requeue_seconds": 300
  },
  "thresholds": {
    "max_workers": 4,
    "min_free_mb": 512,
    "est_worker_mb": 400
  },
  "budget": {
    "enabled": true,
    "max_usd": 5.0,
    "est_usd_per_worker": 0.5
  },
  "watchdog": {
    "enabled": true,
    "check_interval": 15,
    "cooldown_seconds": 65,
    "stall_seconds": 90,
    "needs_input_realert_seconds": 600,
    "review_idle_seconds": 300,
    "realert_seconds": 90,
    "realert_max_seconds": 1800,
    "rate_limit_regex": "rate limit|429|overloaded|too many requests|usage limit"
  },
  "models": {
    "orchestrator": "opus",
    "default_worker": "sonnet"
  },
  "tui_patterns": {
    "busy_regex": "esc to interrupt|Running…|Compacting",
    "active_glyph_regex": "✻|✽|✳|✶",
    "ready_regex": "│ *>|❯|for shortcuts|Try \"",
    "welcome_regex": "Welcome",
    "input_glyph_regex": "│ *>|❯",
    "draft_placeholder_regex": "^(Try \"|for shortcuts|\\? for shortcuts|Context (left|low)|tokens? (saved|left|used))"
  }
}
