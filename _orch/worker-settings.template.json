{
  "_comment": "Reference only. spawn.sh writes a concrete version of this to each worker's worktree at .claude/settings.local.json, substituting the absolute report.sh path and the worker id.",
  "awaySummaryEnabled": false,
  "hooks": {
    "PreToolUse":   [{"matcher":"Edit|Write|MultiEdit|NotebookEdit","hooks":[{"type":"command","command":"/ABS/PATH/_orch/guard-write.sh <id> '<target-repo>' '<worktree>'"}]}],
    "Stop":         [{"hooks":[{"type":"command","command":"/ABS/PATH/_orch/report.sh <id> done --hook"}]}],
    "Notification": [{"matcher":"permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|worker_permission_prompt","hooks":[{"type":"command","command":"/ABS/PATH/_orch/report.sh <id> needs-input"}]}],
    "SubagentStop": [{"hooks":[{"type":"command","command":"/ABS/PATH/_orch/report.sh <id> subagent-done"}]}]
  }
}
